# Configuración de Variables de Entorno - EduSmart
# ========================================================

# Llave secreta de Django
SECRET_KEY=django-insecure-tu_clave_secreta_aqui

# Base de datos (Render / Producción / Local SQLite):
# En producción (Render) se usa la variable de entorno DATABASE_URL automáticamente.
# Para desarrollo local con SQLite descomenta:
# DATABASE_URL=sqlite:///db.sqlite3

# API Key de Google Gemini para simuladores de examen con IA:
# Obtén tu clave gratuita en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# MongoDB para bitácoras y eventos:
MONGODB_URI=mongodb://localhost:27017/
MONGODB_NAME=BD_EDUESMART
